// Table names after import: FactSales and DimDate.
// Create each measure separately in Power BI Desktop.
Total Revenue = SUM(FactSales[Revenue])
Total Cost = SUM(FactSales[Cost])
Gross Profit = [Total Revenue] - [Total Cost]
Gross Margin % = DIVIDE([Gross Profit], [Total Revenue])
Orders = DISTINCTCOUNT(FactSales[OrderId])
Average Order Value = DIVIDE([Total Revenue], [Orders])
Revenue Previous Month = CALCULATE([Total Revenue], DATEADD(DimDate[Date], -1, MONTH))
Revenue MoM % = DIVIDE([Total Revenue] - [Revenue Previous Month], [Revenue Previous Month])
